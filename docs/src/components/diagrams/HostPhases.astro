---
// Static diagram: the Host phases. Source: metal/internal/phase/phase.go (ForHost).
import Figure from '../diagram/Figure.astro';
import Box from '../diagram/Box.astro';
import Edge from '../diagram/Edge.astro';

const row = 30;
const w = 104;
const h = 44;
const xs = [10, 136, 262, 388, 514];
const names = ['Inspecting', 'Available', 'Assigned', 'Provisioning', 'Provisioned'];
const labels = ['Verified', 'claim', 'spec.os', 'OSReady'];
---

<Figure
  title="Host phases. A Host moves from Inspecting to Provisioned. A release takes it back to Available. Maintenance is a stop."
  caption="Host phases. The phase is a summary of the conditions."
  width={666}
  height={232}
  wide
>
  {names.map((n, i) => (
    <Box x={xs[i]} y={row} w={w} h={h} label={n} variant={n === 'Available' ? 'accent' : n === 'Provisioned' ? 'ok' : undefined} />
  ))}
  {xs.slice(0, -1).map((x, i) => (
    <Edge points={[[x + w, row + h / 2], [xs[i + 1], row + h / 2]]} />
  ))}
  {labels.map((l, i) => (
    <text class="t-small t-label" x={xs[i + 1] + 63} y={row - 8} text-anchor="middle">{l}</text>
  ))}
  <Box x={514} y={130} w={w} h={h} label="Releasing" variant="warn" />
  <Box x={240} y={130} w={230} h={h} label="Maintenance" sub="any phase, by annotation" variant="soft" />
  <Edge points={[[566, row + h], [566, 130]]} label="claim deleted" at={[572, 108]} anchor="start" />
  <Edge points={[[566, 174], [566, 206], [188, 206], [188, row + h]]} variant="accent" label="wiped, free again" at={[377, 200]} />
</Figure>
